SECRET_KEY=defina-uma-chave-secreta-longa-aqui
DEBUG=true
SESSION_COOKIE_SECURE=false
# ALLOWED_HOSTS=localhost,127.0.0.1,meu-dominio.com
# CSRF_TRUSTED_ORIGINS=https://meu-dominio.com

# Em produção (Render), defina DEBUG=false e ALLOWED_HOSTS com o host do serviço.
# Em desenvolvimento local com túnel (ex.: Cloudflare Tunnel), adicione o
# domínio do túnel em ALLOWED_HOSTS e CSRF_TRUSTED_ORIGINS.

# Banco de dados: sem as variáveis PG*, o projeto usa SQLite local.
# Configure as seguintes (Render define automaticamente):
# PGDATABASE=...
# PGUSER=...
# PGPASSWORD=...
# PGHOST=...
# PGPORT=5432

# Para envio real de códigos e redefinição de senha, configure SMTP.
# Sem EMAIL_HOST, com DEBUG=true, o e-mail aparece apenas no console local.
# Com DEBUG=false, o SMTP é obrigatório (python manage.py check acusa se faltar).
EMAIL_HOST=smtp.seu-provedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-usuario
EMAIL_HOST_PASSWORD=sua-senha-ou-token
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Krampt <contato@seu-dominio.com>

# Cloudflare R2 (opcional). Defina as quatro variáveis obrigatórias para ativar.
# Sem elas, os uploads continuam no diretório media local.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=krampt-media
# AWS_S3_ENDPOINT_URL=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# Domínio público opcional, sem https:// e sem barra no final:
# AWS_S3_CUSTOM_DOMAIN=media.seu-dominio.com
