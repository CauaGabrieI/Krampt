SECRET_KEY=defina-uma-chave-secreta-longa-aqui
DEBUG=true
SESSION_COOKIE_SECURE=false

# Para envio real de códigos, configure SMTP. Sem EMAIL_HOST, o código aparece
# apenas no console local. No Render, o cadastro exige SMTP configurado.
# EMAIL_HOST=smtp.seu-provedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-usuario
# EMAIL_HOST_PASSWORD=sua-senha-ou-token
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=Krampt <contato@seu-dominio.com>
