SECRET_KEY=defina-uma-chave-secreta-longa-aqui
DEBUG=true
SESSION_COOKIE_SECURE=false

# Em produção (Render), defina DEBUG=false. ALLOWED_HOSTS usa o host do serviço
# (definido no Render), sem liberar hosts de túnel de desenvolvimento.
# Em desenvolvimento local com túnel (ex.: Cloudflare Tunnel), pode ser
# necessário adicionar o domínio do túnel em ALLOWED_HOSTS/CSRF_TRUSTED_ORIGINS.

# Banco de dados: sem as variáveis PG*, o projeto usa SQLite local.
# Configure as seguintes (Render define automaticamente):
# PGDATABASE=...
# PGUSER=...
# PGPASSWORD=...
# PGHOST=...
# PGPORT=5432

# Para envio real de códigos e redefinição de senha, configure SMTP.
# Sem EMAIL_HOST, com DEBUG=true, o e-mail aparece apenas no console local.
# Com DEBUG=false, o SMTP é obrigatório (python manage.py check acusa se faltar).
EMAIL_HOST=smtp.seu-provedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-usuario
EMAIL_HOST_PASSWORD=sua-senha-ou-token
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Krampt <contato@seu-dominio.com>